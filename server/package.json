{
  "name": "source-verifier-server",
  "author": {
    "name": "Tarrgon",
    "url": "https://github.com/Tarrgon"
  },
  "version": "1.0.0",
  "description": "The backend server for the source verifier userscript for e621. Checks sources to supply janitors with information to improve workflow quality of life.",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/express": "^5.0.2",
    "@types/puppeteer": "^5.4.7",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "dependencies": {
    "@atproto/api": "^0.20.5",
    "body-parser": "^2.2.0",
    "buffer-image-size": "^0.6.4",
    "cors": "^2.8.6",
    "debug": "^4.3.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "js-md5": "^0.8.3",
    "jschardet": "^3.1.4",
    "jsdom": "^26.1.0",
    "mongodb": "^6.18.0",
    "node-fetch": "^2.6.6",
    "parse-srcset": "^1.0.2",
    "pixiv-api-client": "github:Tarrgon/pixiv-api-client#2cee9fad782b0bb7725d16728e6bd09cce141cc4",
    "puppeteer": "^24.16.1",
    "sharp": "^0.34.5",
    "sharp-phash": "^2.2.0"
  },
  "scripts": {
    "dev": "tsx watch --enable-source-maps src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run clean && npm run compile && npm run copyfiles && npm run copyenv",
    "compile": "npx tsc && npx tsc-alias",
    "clean": "npx rimraf dist",
    "copyfiles": "npx copyfiles -u 1 \"./src/**/*.html\" \"./src/**/*.js\" \"./src/**/*.json\" \"./src/**/*.png\" ./dist",
    "copyenv": "npx copyfiles .env ./dist",
    "preinstall": "npx rimraf src/shared",
    "postinstall": "cd src && mkdir shared && cd shared && git init && git remote add -f origin https://github.com/Tarrgon/source-verifier.git && git config core.sparsecheckout true && git sparse-checkout set --no-cone \"shared\" && git pull --depth=1 origin master && npx copyfiles \"./**\" ../ && npx rimraf shared",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:bup": "npm run docker:build && npm run docker:up"
  }
}

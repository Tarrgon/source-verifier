{
  "name": "source-verifier-server",
  "author": {
    "name": "Tarrgon",
    "url": "https://github.com/Tarrgon"
  },
  "version": "1.0.0",
  "description": "The backend server for the source verifier userscript for e621. Checks sources to supply janitors with information to improve workflow quality of life.",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/express": "^5.0.2",
    "@types/puppeteer": "^5.4.7",
    "eslint": "^9.27.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1"
  },
  "dependencies": {
    "@atproto/api": "^0.20.5",
    "body-parser": "^2.2.0",
    "buffer-image-size": "^0.6.4",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "js-md5": "^0.8.3",
    "jschardet": "^3.1.4",
    "jsdom": "^26.1.0",
    "mongodb": "^6.18.0",
    "parse-srcset": "^1.0.2",
    "pixiv-api-client": "github:Tarrgon/pixiv-api-client",
    "puppeteer": "^24.16.1",
    "sharp": "^0.34.5",
    "sharp-phash": "^2.2.0"
  },
  "scripts": {
    "dev": "tsx watch --enable-source-maps src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run clean && tsc && npm run copyfiles",
    "clean": "npx rimraf dist",
    "copyfiles": "npx copyfiles -u 1 \"./src/**/*.html\" ./dist"
  }
}